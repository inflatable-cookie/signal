{
  "name": "loophole-signal-tools",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "cmake -S . -B build && cmake --build build --config Debug",
    "dev": "cmake -S . -B build && cmake --build build --config Debug && ./build/src/loophole-signal",
    "audit:god-files": "python3 ../chorus/meta/tools/check_god_file_audit.py --workspace-root .. --fail-on high",
    "test": "cmake -S . -B build && cmake --build build --config Debug && ctest --test-dir build --output-on-failure"
  }
}
