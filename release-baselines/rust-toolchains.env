# Toolchains the release floor gate requires. Update deliberately: the floor
# is a compatibility promise to consumers, reviewed at each dependency sweep.
#
# 1.95.0 is the portfolio floor, raised from 1.90.0 on 2026-08-06: `cfg_select`
# stabilised in 1.95 and libsqlite3-sys needs it (reached via longhorn's
# rusqlite), and underlay had independently moved to 1.94. 1.95 is the measured
# portfolio ceiling -- the highest floor every project can still meet.
SIGNAL_GENERAL_MSRV=1.95.0
SIGNAL_CURRENT_STABLE=1.97.1
